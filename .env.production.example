# Copy to .env on the VPS — `docker compose` reads this file automatically.
#   cp .env.production.example .env && nano .env
# Never commit the real .env (it is gitignored).

# The domain Caddy serves and obtains TLS certificates for.
# Must already point at this VPS's IP (A record) before the first deploy.
# Use SITE_DOMAIN=:80 to run without TLS (no domain yet / local testing).
SITE_DOMAIN=truoffers.co.uk
SITE_URL=https://truoffers.co.uk

# REQUIRED. Generate with: openssl rand -hex 32
# The API refuses to boot in production with a default/dev secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional: encrypts the API keys saved in /admin/settings. Defaults to JWT_SECRET. Set it once and keep it:
# changing it makes the saved keys unreadable (they then fall back to the values below).
SETTINGS_ENCRYPTION_KEY=

# The integrations below can be set here OR in /admin/settings (a key saved in the admin panel wins).
# Stripe (blank = plan and promotion checkouts run in mock mode). Webhook endpoint: ${SITE_URL}/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio Verify: SMS and voice codes for the claim phone check (blank = test mode, no code is sent;
# outside production the code is shown on screen)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Campaign text messages: a Messaging Service with a UK sender (blank = texts are only logged)
TWILIO_MESSAGING_SERVICE_SID=

# Transactional email through Resend (blank = emails are only written to the email log in the admin panel)
RESEND_API_KEY=
# The sender; its domain must be verified with Resend
EMAIL_FROM=TruOffers <hello@truoffers.co.uk>

# Google reCAPTCHA v2/v3 for guest offer reports (blank = no CAPTCHA)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Social login (blank = the Google/Apple buttons show "not configured")
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Google review sync (blank = seeded ratings are kept)
GOOGLE_PLACES_API_KEY=

# AI offer writer (blank = falls back to template copy). With a key, admins can also turn on the
# scraper's AI extraction fallback in /admin/scraper/settings; it is off by default.
ANTHROPIC_API_KEY=
# Model for scraper AI extraction (only used when the fallback is enabled)
SCRAPER_AI_MODEL=claude-opus-5

# Where uploaded files live: "disk" (the api-uploads volume, the default) or "s3" for an S3-compatible bucket
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO). The bucket stays private: files are still served through the API.
# Switching an existing site: set these, run `docker compose exec api npm run storage:copy-to-s3:prod`, redeploy.
STORAGE_DRIVER=disk
S3_BUCKET=
S3_REGION=
# For non-AWS providers, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
