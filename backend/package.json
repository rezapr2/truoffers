{
  "name": "truoffers-backend",
  "version": "0.1.0",
  "description": "TruOffers.co.uk API - UK takeaway offers & discovery platform",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile main-worker --watch",
    "start:worker:prod": "node dist/main-worker",
    "seed": "ts-node -r tsconfig-paths/register src/seed/seed.ts",
    "seed:prod": "node dist/seed/seed.js",
    "migrate:scraper": "ts-node -r tsconfig-paths/register src/scripts/migrate-scraper.ts",
    "migrate:scraper:prod": "node dist/scripts/migrate-scraper.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration",
    "test:e2e": "jest --runInBand --selectProjects e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^7.0.2",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.13",
    "luxon": "^3.7.2",
    "mongoose": "^8.9.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "playwright-core": "1.62.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "robots-parser": "^3.0.1",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "stripe": "^22.3.2",
    "tldts": "^7.4.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  }
}
