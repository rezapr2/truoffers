# Copy to .env and adjust
PORT=4000
MONGODB_URI=mongodb://localhost:27017/truoffers
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Integrations: set here or in /admin/settings (a key saved in the admin panel wins; it is stored
# encrypted with SETTINGS_ENCRYPTION_KEY, or JWT_SECRET when that is blank).
SETTINGS_ENCRYPTION_KEY=
# Stripe (leave blank in dev: plan and promotion checkouts run in mock mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Twilio Verify for the claim phone check (blank: test mode, the code is returned to the browser outside production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Campaign texts (blank: texts only go to the message log)
TWILIO_MESSAGING_SERVICE_SID=
# Resend for transactional email (blank: emails only go to the email log in /admin/notifications)
RESEND_API_KEY=
EMAIL_FROM=TruOffers <hello@truoffers.co.uk>
# reCAPTCHA for guest offer reports (blank: no CAPTCHA)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Foodbell integration: the secret Foodbell also holds (as TRUOFFERS_SHARED_SECRET) and Foodbell's API
# (default https://api.foodbell.co.uk/api). Blank secret: owners can't connect yet.
FOODBELL_SHARED_SECRET=
FOODBELL_API_URL=

# Uploaded photos, menus and private verification documents (default: ./uploads)
UPLOAD_DIR=
# Or keep them in an S3-compatible bucket: STORAGE_DRIVER=s3 plus the S3_* values
STORAGE_DRIVER=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Development only: skip the two-factor sign-in that staff accounts otherwise need. Ignored in production.
ADMIN_2FA_DISABLED=

# Social login (leave blank to disable the providers)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Google review sync (leave blank to disable — seeded ratings are kept)
GOOGLE_PLACES_API_KEY=

# AI offer writer (leave blank — falls back to template copy). The scraper also uses this key for its
# optional AI extraction fallback, which stays off until an admin enables it in scraper settings.
ANTHROPIC_API_KEY=
SCRAPER_AI_MODEL=claude-opus-5

# Scraper job queue (the API and `npm run start:worker` share it)
REDIS_URL=redis://localhost:6379
# Public site URL: the crawler's User-Agent links to ${SITE_URL}/bot
SITE_URL=http://localhost:3000

# Tests and local E2E only: comma-separated *.test hostnames the crawler may reach on private
# addresses. Both processes refuse to start if this is set with NODE_ENV=production.
SCRAPER_FIXTURE_HOSTS=
